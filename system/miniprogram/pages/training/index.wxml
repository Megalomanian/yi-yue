<view class="page"><view class="title">培训与考核</view><block wx:if="!course"><view wx:for="items" wx:key="id" class="card">{{item.name}}<button wx:if="!item.enrollment" class="secondary" data-id="{{item.id}}" bindtap="enroll">报名培训</button><button wx:elif="item.enrollment.approved" class="primary" data-id="{{item.id}}" bindtap="exam">学习与考核</button><view wx:else class="subtitle">等待机组资格初审</view></view></block><block wx:else><view class="card"><view class="title" style="font-size:30rpx">{{course.title}}</view><view wx:for="course.material" wx:key="*this" class="subtitle">{{index+1}}. {{item}}</view></view><view wx:for="course.questions" wx:for-item="question" wx:for-index="qi" wx:key="question" class="card"><view>{{qi+1}}. {{question.question}}</view><radio-group data-index="{{qi}}" bindchange="answer"><label wx:for="question.options" wx:for-item="option" wx:for-index="oi" wx:key="*this" style="display:block;margin-top:20rpx"><radio value="{{oi}}" checked="{{answers[qi]===oi}}"/>{{option}}</label></radio-group></view><button class="primary" bindtap="submit">提交考核</button></block></view>
