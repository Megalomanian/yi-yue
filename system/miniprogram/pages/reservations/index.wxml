<view class="page"><view class="title">我的预约</view><view wx:for="items" wx:key="id" class="card"><view class="row"><text>#{{item.id}}</text><text class="tag">{{item.label}}</text></view><view class="title" style="font-size:30rpx">{{item.instrument_name}}</view><view class="subtitle">{{item.start_at}} 至 {{item.end_at}}<text>\n</text>{{item.project}}</view><view wx:if="item.reason" class="notice">{{item.reason}}</view><button wx:if="item.status==='Approved'&&!item.confirmed" class="primary" data-id="{{item.id}}" data-action="confirm" bindtap="action">确认候补补位</button><button wx:if="item.status==='Approved'&&item.confirmed" class="primary" data-id="{{item.id}}" bindtap="scan">扫码上机签到</button><button wx:if="item.status==='Draft'" class="primary" data-id="{{item.id}}" data-action="submit" bindtap="action">提交草稿</button><button wx:if="item.status==='Approved'||item.status==='Waitlisted'" class="secondary" data-id="{{item.id}}" bindtap="cancel">取消预约</button><view wx:if="item.bills.length" class="price">费用 ¥{{item.bills[0].amount}}</view><button wx:for="item.reports" wx:for-item="report" wx:key="id" class="secondary" data-id="{{report.id}}" bindtap="download">下载 {{report.filename}}</button></view><view wx:if="!items.length" class="empty">暂无预约，前往仪器资源选择机时。</view></view>

