<view class="page"><view class="title">{{step+1}} / 3 · {{step===0?'选择机时':step===1?'填写样品':'确认预约'}}</view><view wx:if="step===0"><picker mode="date" value="{{date}}" bindchange="date">日期：{{date}}</picker><view style="display:flex;flex-wrap:wrap;gap:14rpx"><button wx:for="slots" wx:key="start_at" style="width:30%;font-size:24rpx;margin:0 0 12rpx" class="{{selected===index?'primary':'secondary'}}" disabled="{{item.state==='停用'||item.state==='已过期'}}" data-index="{{index}}" bindtap="select">{{item.time}} {{item.state}}</button></view></view><view wx:if="step===1" class="card"><view class="label">样品数</view><input type="number" value="{{samples}}" data-key="samples" bindinput="input"/><textarea placeholder="检测项目与样品说明" data-key="project" bindinput="input"/><input placeholder="联系方式" data-key="contact" bindinput="input"/><input placeholder="经费卡 / 项目号 / 对公信息" data-key="settlement" bindinput="input"/></view><view wx:if="step===2" class="card"><view>{{slots[selected].start_at}} 至 {{slots[selected].end_at}}</view><view class="subtitle">{{samples}}份样品 · {{project}}</view><view class="notice">最终费用按实际使用时间结算。开始15分钟未签到将记违约；同一时段满员则进入候补。</view></view><button wx:if="step<2" class="primary" bindtap="next">下一步</button><button wx:else class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">确认提交</button><button wx:if="step>0" class="secondary" bindtap="back">上一步</button></view>
