<view class="page"><view class="card"><view class="title">{{me.name}}</view><view class="price">信用 {{me.credit}} 分</view><view class="subtitle">低于60分暂停预约，可对违约记录提交申诉。</view><button class="primary" bindtap="training">培训与资质认证</button></view><view class="title" style="font-size:30rpx">我的资质</view><view wx:for="qualifications" wx:key="id" class="card">{{item.instrument_name}}<view class="subtitle">{{item.revoked?'已撤销':item.expires_at+' 到期'}}</view></view><view class="title" style="font-size:30rpx">信用记录</view><view wx:for="violations" wx:key="id" class="card">{{item.reason}} · 扣{{item.points}}分<view class="subtitle">{{item.resolved?(item.restored?'已恢复分数':'维持认定'):'可提交申诉'}}</view><button wx:if="!item.resolved" class="secondary" data-id="{{item.id}}" bindtap="appeal">申诉</button></view><view class="title" style="font-size:30rpx">消息中心</view><view wx:for="notifications" wx:key="id" class="card">{{item.message}}<view class="subtitle">{{item.created_at}}</view><button wx:if="!item.is_read" class="secondary" data-id="{{item.id}}" bindtap="read">标记已读</button></view><button class="secondary" bindtap="logout">退出登录</button></view>
