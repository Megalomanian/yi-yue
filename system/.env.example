# Copy to .env, replace every value with independent random secrets.
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-random-redis-password
MINIO_PASSWORD=replace-with-a-random-storage-password
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-independent-32-random-characters
BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
DEMO_MODE=false
WEB_PORT=8088
